{
    "name": "invoq/invoq-php",
    "description": "PHP SDK for invoq server APIs and webhook verification.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "invoq",
        "stablecoin",
        "payments",
        "php",
        "sdk"
    ],
    "authors": [
        {
            "name": "invoq"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-hash": "*",
        "ext-json": "*"
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Invoq\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
